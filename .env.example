# =============================================================================
# Athlete Stress Sim — example environment variables
# Copy this file to `.env` and fill in the real values. `.env` is listed in
# .gitignore and must NEVER be committed.
# =============================================================================

# --- Polar AccessLink (OAuth2) ---------------------------------------------
# Obtained at https://admin.polaraccesslink.com/ (S2).
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
POLAR_REDIRECT_URI=http://localhost:8000/auth/callback
POLAR_ACCESS_TOKEN=
POLAR_REFRESH_TOKEN=

# --- Athlete physiology (user zero) ----------------------------------------
# Reference priors; the EKF (S9) will tune them with real data.
ATHLETE_HR_MAX=200
ATHLETE_HR_REST=55
ATHLETE_TAU_1=45
ATHLETE_TAU_2=15
ATHLETE_K_1=1.0
ATHLETE_K_2=2.0
ATHLETE_B=1.92
ATHLETE_RPE_ALPHA=1.0
