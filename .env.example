# =============================================================================
# Athlete Stress Sim — example environment variables
# Copy this file to `.env` and fill in the real values. `.env` is listed in
# .gitignore and must NEVER be committed.
# =============================================================================

# --- Polar AccessLink (OAuth2) ---------------------------------------------
# Client credentials are created at https://admin.polaraccesslink.com/ (S2).
# The redirect URI must match the one registered for the client, exactly.
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
POLAR_REDIRECT_URI=http://localhost:8000/auth/callback
POLAR_AUTHORIZE_URL=https://flow.polar.com/oauth2/authorization
POLAR_TOKEN_URL=https://polarremote.com/v2/oauth2/token
POLAR_API_URL=https://www.polaraccesslink.com/v3
POLAR_SCOPE=accesslink.read_all
POLAR_MEMBER_ID=athlete-stress-sim
POLAR_SYNC_ON_STARTUP=true

# --- Athlete physiology (user zero) ----------------------------------------
# Reference priors; the EKF (S9) will tune them with real data.
ATHLETE_HR_MAX=200
ATHLETE_HR_REST=55
ATHLETE_TAU_1=45
ATHLETE_TAU_2=15
ATHLETE_K_1=1.0
ATHLETE_K_2=2.0
ATHLETE_SEX=male

# --- Local storage ----------------------------------------------------------
ATHLETE_DB_PATH=data/athleta.duckdb
ATHLETE_RAW_DATA_DIR=data/raw
